# Frontend (Next.js) settings. For local development copy this file to
# .env.local; every value has a working default, so it's optional.
# In Docker Compose these come from backend/configs/.env.<env> instead.

# Where the Next.js server reaches the Express API. Only the server uses it:
# browsers talk to Next.js, which forwards to this URL.
BACKEND_URL=http://localhost:5000/api/v1

# Lifetime of the refresh-token cookie in seconds; keep equal to the
# backend's REFRESH_TOKEN_TTL.
REFRESH_TOKEN_TTL=604800

# true = session cookies only sent over HTTPS. Leave false for plain http.
COOKIE_SECURE=false
