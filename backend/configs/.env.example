# =====================================================================
# Doctor Tracker settings for one environment (here: development).
# Read by:
#   - docker compose  (--env-file ./backend/configs/.env.development)
#   - the backend     (loads configs/.env.$NODE_ENV on start)
#   - the frontend container (docker compose passes this file to it)
# Running the frontend outside Docker? Use frontend/.env.local instead
# (see frontend/.env.example); the defaults already work locally.
# Copy this file to .env.development and fill in the values.
# =====================================================================

# ---------- MongoDB (used by docker-compose) ----------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me
MONGO_DB_NAME=doctor_tracker
MONGO_PORT=27019

# ---------- Redis (used by docker-compose) ----------
REDIS_PASSWORD=change_me
REDIS_PORT=6381

# ---------- Backend container (used by docker-compose) ----------
# Host port for the backend container (use another one to run `npm run dev` alongside it)
BACKEND_PORT=5000
# Env file the backend container reads (default: this file)
# BACKEND_ENV_FILE=./backend/configs/.env.production

# ---------- Backend app ----------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://admin:change_me@localhost:27019/doctor_tracker?authSource=admin
REDIS_URL=redis://:change_me@localhost:6381

# ---------- Auth ----------
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=another_long_random_string_different_from_access_secret
# Token lifetimes in seconds (15 minutes / 7 days)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
ENABLE_REGISTRATION=false

# ---------- Frontend (Next.js) ----------
# Used by the frontend's server (route handlers), never sent to browsers.
# Where Next.js reaches the API. Docker Compose overrides it to the
# in-network address http://backend:5000/api/v1.
BACKEND_URL=http://localhost:5000/api/v1
# true = session cookies only over HTTPS (set true when deployed with HTTPS)
COOKIE_SECURE=false
# Host port for the frontend container (docker compose)
FRONTEND_PORT=3000

# ---------- CORS (comma separated) ----------
CORS_ORIGIN=http://localhost:3000

# Proxies allowed to set X-Forwarded-For (Express "trust proxy" syntax)
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---------- Seed (npm run seed: first Super Admin) ----------
# Demo credentials from the README; use your own in production.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345

# Demo hospitals, doctors, patients and consultations (backend/data/demo).
# Keep false in production. Every demo doctor signs in with SEED_DEMO_PASSWORD.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Doctor@123
